DJANGO_SECRET_KEY=replace-with-a-secure-local-secret-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database - leave blank to use SQLite (default for local dev)
DATABASE_URL=

# CORS - frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Data source mode: demo | live
DATA_SOURCE_MODE=demo

# Optional external API keys (not required for demo mode)
WEATHER_API_KEY=
AGMARKNET_API_KEY=

# JWT settings (seconds)
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=86400

# File upload limits (bytes)
MAX_UPLOAD_SIZE=10485760
